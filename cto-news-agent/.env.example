# Green API (alternative)
GREENAPI_INSTANCE_ID=
GREENAPI_API_TOKEN=

# Recipient
CTO_WHATSAPP_NUMBER=whatsapp:+966XXXXXXXXX

# ── Schedule ──
BRIEFING_SCHEDULE=0 8 * * 0
TIMEZONE=Asia/Riyadh

# ── Report Hosting ──
REPORT_BASE_URL=http://localhost:3001/briefings
